# Copy to .env and fill in. NEVER commit .env.
FLASK_ENV=development
# Generate both values with: python scripts/generate_keys.py
SECRET_KEY=
MASTER_KEY=

# MySQL (create the database and user first, see README)
DATABASE_URL=mysql+pymysql://resume_app:CHANGE_ME@localhost:3306/resume_ai?charset=utf8mb4

# ClamAV daemon (unix socket on Linux, or TCP)
CLAMD_SOCKET=/var/run/clamav/clamd.ctl
CLAMD_HOST=
CLAMD_PORT=3310

# Upload limits
MAX_UPLOAD_MB=5
UPLOAD_DIR=instance/uploads

# Sessions
SESSION_LIFETIME_MINUTES=30
COOKIE_SECURE=false   # set true when serving over HTTPS

# External AI APIs are disabled by default; local NLP only
ALLOW_EXTERNAL_AI=false

# Phase 4-6 settings
MAX_RESUMES_PER_USER=10
RETENTION_DAYS=90
MAX_UNCOMPRESSED_MB=50
# Fail closed: reject uploads when ClamAV is unreachable. Set false ONLY on a dev machine without ClamAV.
CLAMD_REQUIRED=true
LOGIN_MAX_FAILURES=5
LOCKOUT_MINUTES=15
ABSOLUTE_SESSION_HOURS=8
